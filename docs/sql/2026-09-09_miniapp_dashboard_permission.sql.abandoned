-- 小程序数据统计接口权限配置（菜单侧）
-- 2026-09-09 新增 / 2026-09-09 修正库名
--
-- 说明：小程序统计接口复用 PC 端「数据统计」菜单权限（/hrm/dataStatistics）。
-- 权限链路：员工 token → tb_api_permission 把 /mp/dashboard/* 映射到 /hrm/dataStatistics
--          → 命中所属角色在 tbrolemenu 里是否勾了该菜单（任一角色勾选即开通）。
--
-- ⚠️ 库名修正：tbmenu / tbroletypes / tbrolemenu 都在【租户库 hr_XXXX】，不在系统库 hrsystem。
--    只有 tb_api_permission 在系统库 hrsystem。旧版本脚本误写 hrsystem.tbmenu，勿照跑。
--
-- 用法：把下面的 {DB} 全部替换成目标租户库名（如 hr_0001）后执行。
--     新租户开通已由 seed-data.sql 自动带入菜单(id=1030)与系统管理员授权，无需重复执行。

-- 1. 补建「数据统计」菜单（幂等；showMenu='0' = 侧边栏不显示，仅作权限开关）
INSERT INTO `{DB}`.`tbmenu` (id, pid, name, path, canuse, component, redirect, icon, showMenu)
SELECT 1030, 0, '数据统计', '/hrm/dataStatistics', 1, NULL, NULL, NULL, '0'
FROM DUAL
WHERE NOT EXISTS (SELECT 1 FROM `{DB}`.`tbmenu` WHERE id = 1030 OR path = '/hrm/dataStatistics');

-- 2. 给需要看统计的角色授权（示例：管理员/系统管理员/人事专员，按实际角色增删）
SET @i := 0;
INSERT INTO `{DB}`.`tbrolemenu` (role_menu_id, role_id, menu_id)
SELECT 2069000000000000000 + (@i := @i + 1), r.id, 1030
FROM `{DB}`.`tbroletypes` r
WHERE r.name IN ('管理员', '系统管理员', '人事专员')
  AND NOT EXISTS (SELECT 1 FROM `{DB}`.`tbrolemenu` rm WHERE rm.role_id = r.id AND rm.menu_id = 1030);

-- 3. 接口映射（系统库，跨租户一份）：见同目录 2026-09-09_miniapp_dashboard_api_permission.sql
--    或在 PC 端【权限管理 → 菜单权限清单】点「刷新权限映射」

-- 4. 验证：菜单是否已建
SELECT id, pid, name, path, showMenu FROM `{DB}`.`tbmenu` WHERE id = 1030;

-- 5. 验证：哪些角色已拿到该菜单
SELECT r.id, r.name
FROM `{DB}`.`tbrolemenu` rm
JOIN `{DB}`.`tbroletypes` r ON r.id = rm.role_id
WHERE rm.menu_id = 1030;

-- 6. 验证：接口映射是否已生效
SELECT api_prefix, menu_paths, match_type
FROM hrsystem.tb_api_permission
WHERE api_prefix LIKE '/mp/dashboard%';
