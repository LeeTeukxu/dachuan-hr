# ==========================================================
# HR 系统 SaaS 化 - 环境变量配置示例
# 用法：复制为启动环境变量，或写入 systemd unit / docker-compose 的 environment 段
# 所有变量均有默认值（本地开发可零配置启动），生产环境必须显式设置！
# ==========================================================

# 主数据库（建议生产使用专用账号，禁用 root）
HR_DB_USERNAME=root
HR_DB_PASSWORD=请替换为数据库密码

# Redis 密码（生产必须设置）
HR_REDIS_PASSWORD=

# FTP 备份账号
HR_FTP_PASSWORD=ftp_123_user

# 钉钉应用凭证
HR_DDTALK_APPSECRET=请替换为钉钉appsecret

# 微信小程序密钥
HR_WX_MINIAPP_SECRET=请替换为小程序secret

# 定时任务回调白名单（逗号分隔主机名/IP，防 SSRF）
# 默认 localhost,127.0.0.1；如定时任务需回调其他内网服务再追加
# HR_SCHEDULED_WHITELIST=localhost,127.0.0.1,192.168.0.26
